# Servidor
PORT=3000
NODE_ENV=production
BASE_URL=http://SEU_IP_OU_DOMINIO:3000

# JWT Secret (gere uma string aleatória segura)
JWT_SECRET=sua_chave_secreta_aqui_mude_isso

# Admin padrão (mude após primeiro acesso)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=inforcenter@2026

# Validação por SMS para visitantes (0 = desativada: libera com nome+telefone; 1 = exige código OTP)
OTP_ENABLED=0

# Zenvia SMS (necessário apenas se OTP_ENABLED=1)
ZENVIA_TOKEN=seu_token_zenvia_aqui
ZENVIA_FROM=Inforcenter

# Integração com o IXC Soft — mesmos dados usados no app do assinante (App-InforCenter/.env)
# Valida CPF + senha do hotsite para liberar acesso direto aos clientes
IXC_BASE_URL=https://inforcenterfibra.com.br/webservice/v1
IXC_TOKEN=id_token:hash_token

# MikroTik
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=sua_senha_mikrotik
MIKROTIK_HOTSPOT_SERVER=hotspot1
MIKROTIK_USER_PROFILE=inforcenter-default

# OTP Config
OTP_EXPIRY_MINUTES=5

# Tempo de acesso (em minutos) — visitante (lead) e cliente Inforcenter autenticado por CPF
HOTSPOT_FREE_TIME=60
CLIENT_FREE_TIME=480
